# GitHub Account & Wiki Inspector Configuration Example
# Copy this file to .env and fill in your details:
#   cp .env.example .env

# Your GitHub Personal Access Token (PAT)
# Generate one at: https://github.com/settings/tokens
# For public repos: 'read:user' or no special scopes needed.
# For private repos: check 'repo' scope.
GITHUB_TOKEN=your_github_personal_access_token_here

# Your GitHub Username or Profile URL:
# Examples:
#   GITHUB_USERNAME=your_username
#   GITHUB_USERNAME=https://github.com/your_username
GITHUB_USERNAME=your_username_here

# Output directory for the generated LLM wiki markdown files (default: ./reports)
OUTPUT_DIR=./reports

# Include forked repositories (true/false, default: true)
INCLUDE_FORKS=true

# Filter by visibility (all / public / private, default: all)
REPO_VISIBILITY=all
